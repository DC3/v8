+void MicrotaskQueue::PerformReentrantCheckpoint(v8::Isolate* v8_isolate) {
+  Isolate* isolate = reinterpret_cast<Isolate*>(v8_isolate);
+  if (isolate->is_execution_terminating()) {
+    tick_task_ = 0;
+    return;
