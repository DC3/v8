+  HandleScope scope(isolate);
+  DirectHandle<Object> receiver = args.receiver();
+  if (!IsJSModuleNamespace(*receiver) || IsJSDeferredModuleNamespace(*receiver)) {
+    return ReadOnlyRoots(isolate).undefined_value();
