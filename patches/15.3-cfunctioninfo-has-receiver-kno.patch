+TEST(FastApiCallsWithoutReceiver) {
+#if !defined(V8_LITE_MODE) && defined(V8_ENABLE_TURBOFAN) && \
+    !defined(USE_SIMULATOR)
+  if (i::v8_flags.jitless || i::v8_flags.disable_optimizing_compilers) return;
+  i::FlagScope<bool> fast_api(&i::v8_flags.turbo_fast_api_calls, true);
+  i::FlagScope<bool> natives(&i::v8_flags.allow_natives_syntax, true);
+  i::FlagScope<bool> concurrent(&i::v8_flags.concurrent_recompilation, false);
+
+  CcTest::InitializeVM();
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  static int noop_fast, noop_slow, identity_fast, identity_slow;
+  noop_fast = noop_slow = identity_fast = identity_slow = 0;
+  static const v8::CFunctionInfo noop_info(
+      v8::CTypeInfo(v8::CTypeInfo::Type::kVoid), 0, nullptr,
+      v8::CFunctionInfo::Int64Representation::kNumber,
+      v8::CFunctionInfo::HasReceiver::kNo);
+  static const v8::CTypeInfo identity_args[] = {
+      v8::CTypeInfo(v8::CTypeInfo::Type::kInt32)};
+  static const v8::CFunctionInfo identity_info(
+      v8::CTypeInfo(v8::CTypeInfo::Type::kInt32), 1, identity_args,
+      v8::CFunctionInfo::Int64Representation::kNumber,
+      v8::CFunctionInfo::HasReceiver::kNo);
+  v8::CFunction noop_c_function(
+      reinterpret_cast<const void*>(+[]() { ++noop_fast; }), &noop_info);
+  v8::CFunction identity_c_function(
+      reinterpret_cast<const void*>(+[](int32_t value) -> int32_t {
+        ++identity_fast;
+        return value;
+      }),
+      &identity_info);
+  CHECK_EQ(0, noop_c_function.ArgumentCount());
+  CHECK_EQ(1, identity_c_function.ArgumentCount());
+  CHECK(!noop_info.HasReceiverArg());
+  CHECK(!identity_info.HasReceiverArg());
+
+  Local<v8::ObjectTemplate> object_template = v8::ObjectTemplate::New(isolate);
+  object_template->Set(
+      isolate, "noop",
+      v8::FunctionTemplate::New(
+          isolate,
+          [](const v8::FunctionCallbackInfo<v8::Value>& info) {
+            CHECK(i::ValidateCallbackInfo(info));
+            ++noop_slow;
+          },
+          Local<Value>(), Local<v8::Signature>(), 0,
+          v8::ConstructorBehavior::kThrow, v8::SideEffectType::kHasSideEffect,
+          &noop_c_function));
+  object_template->Set(
+      isolate, "identity",
+      v8::FunctionTemplate::New(
+          isolate,
+          [](const v8::FunctionCallbackInfo<v8::Value>& info) {
+            CHECK(i::ValidateCallbackInfo(info));
+            ++identity_slow;
+            info.GetReturnValue().Set(
+                info[0]->Int32Value(info.GetIsolate()->GetCurrentContext())
+                    .FromJust());
+          },
+          Local<Value>(), Local<v8::Signature>(), 1,
+          v8::ConstructorBehavior::kThrow, v8::SideEffectType::kHasSideEffect,
+          &identity_c_function));
+  CHECK(env->Global()
+            ->Set(env.local(), v8_str("receiverless"),
+                  object_template->NewInstance(env.local()).ToLocalChecked())
+            .FromJust());
+  CompileRun(R"JS(
+    function callNoop() { return receiverless.noop(); }
+    function callIdentity(value) { return receiverless.identity(value); }
+    %PrepareFunctionForOptimization(callNoop);
+    %PrepareFunctionForOptimization(callIdentity);
+    callNoop(); callNoop();
+    callIdentity(31); callIdentity(31);
+    %OptimizeFunctionOnNextCall(callNoop);
+    %OptimizeFunctionOnNextCall(callIdentity);
+  )JS");
+  CHECK_GT(noop_slow, 0);
+  CHECK_GT(identity_slow, 0);
+  noop_fast = noop_slow = identity_fast = identity_slow = 0;
+  CHECK(CompileRun("callNoop()")->IsUndefined());
+  CHECK_EQ(31, CompileRun("callIdentity(31)")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(std::numeric_limits<int32_t>::min(),
+           CompileRun("callIdentity(-2147483648)")
+               ->Int32Value(env.local()).FromJust());
+  CHECK_EQ(std::numeric_limits<int32_t>::max(),
+           CompileRun("callIdentity(2147483647)")
+               ->Int32Value(env.local()).FromJust());
+  CHECK_EQ(1, noop_fast);
+  CHECK_EQ(3, identity_fast);
+  CHECK_EQ(0, noop_slow);
+  CHECK_EQ(0, identity_slow);
+  CHECK_EQ(31, CompileRun("callIdentity('31')")
+                   ->Int32Value(env.local()).FromJust());
+  CHECK_EQ(3, identity_fast);
+  CHECK_EQ(1, identity_slow);
+#endif
+}
