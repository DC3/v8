+
+void CallBoundedNative::GenerateCode(MaglevAssembler* masm,
+                                     const ProcessingState& state) {
+  AllowExternalCallThatCantCauseGC scope(masm);
+  const int argc = returns_void() ? 1 : 2;
+  __ movq(__ ExternalReferenceAsOperand(IsolateFieldId::kContext),
+          ToRegister(ContextInput()));
+#ifndef V8_ENABLE_DIRECT_HANDLE
+  // Local<Value> is a pointer to a real tagged slot in indirect-handle builds.
+  // Keep that slot above the C alignment area, until CallCFunction restores SP.
+  __ Push(kCArgRegs[0]);
+  __ movq(kCArgRegs[0], rsp);
+#endif
+  __ PrepareCallCFunction(argc);
+  __ Move(rax,
+          ExternalReference::Create(address(), ExternalReference::FAST_C_CALL));
+  __ movq(__ ExternalReferenceAsOperand(IsolateFieldId::kFastApiCallTarget),
+          rax);
+  // The default publishes FP/PC and restores the saved SP immediately on
+  // return. There is deliberately no GC/lazy-deopt point at the C return PC.
+  __ CallCFunction(rax, argc);
+#ifndef V8_ENABLE_DIRECT_HANDLE
+  __ addq(rsp, Immediate(kSystemPointerSize));
+#endif
+  __ movq(__ ExternalReferenceAsOperand(IsolateFieldId::kFastApiCallTarget),
+          Immediate(0));
+#ifdef DEBUG
+  __ movq(__ ExternalReferenceAsOperand(IsolateFieldId::kContext),
+          Immediate(Context::kNoContext));
+#endif
+  if (returns_void()) {
+    __ LoadRoot(rax, RootIndex::kUndefinedValue);
+  } else {
+    if constexpr (SmiValuesAre32Bits()) {
+      // No allocation, overflow check or deopt may replay the completed call.
+      __ UncheckedSmiTagInt32(rax);
+    } else {
+      UNREACHABLE();  // The graph builder excludes i32 on 31-bit Smi builds.
+    }
+  }
+}
