+
+void CallBoundedNative::SetValueLocationConstraints() {
+  UseRegister(ContextInput());
+  UseFixed(ReceiverInput(), kCArgRegs[0]);
+  if (returns_void()) {
+    UseAny(ValueInput());
+  } else {
+    UseFixed(ValueInput(), kCArgRegs[1]);
+  }
+  DefineAsFixed(this, kReturnRegister0);
