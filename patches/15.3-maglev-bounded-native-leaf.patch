+  CHECK_EQ(0, bounded_noop_slow);
+  ExpectInt32("tfIdentity(-2147483648)", std::numeric_limits<int32_t>::min());
+  ExpectInt32("tfIdentity(2147483647)", std::numeric_limits<int32_t>::max());
+  ExpectInt32("tfStrict(31)", 31);
+  CHECK_EQ(3, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  CHECK_EQ(v8::Utils::OpenDirectHandle(*env->Global())->ptr(),
+           bounded_receiver);
+
+  // Check both the default fast path and its exception path while marked
+  // functions with the identical scalar signature remain in the same context.
+  default_throwing_i32_fast = 0;
+  ExpectInt32("tfDefaultIdentity(31)", 31);
+  CHECK_EQ(1, default_throwing_i32_fast);
+  default_i32_throw = true;
+  ExpectTrue(R"JS(
+    (() => { try { tfDefaultIdentity(31); } catch (e) {
+      return e === 'default fast exception';
+    } return false; })()
