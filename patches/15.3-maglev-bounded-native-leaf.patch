+TEST(FastApiBoundedNativeMaglev) {
+#if defined(V8_ENABLE_MAGLEV) && defined(V8_TARGET_ARCH_X64) && V8_OS_LINUX && \
+    !defined(USE_SIMULATOR)
+  if (i::v8_flags.jitless || i::v8_flags.disable_optimizing_compilers) return;
+  BoundedNativeMaglevTest flags;
+  v8::HandleScope scope(CcTest::isolate());
+  LocalContext env;
+  flags.Install(env.local());
+  CompileRun(R"JS(
+    function callNoop() { return boundedNoop(); }
+    function callIdentity(value) { return boundedIdentity(value); }
+    function callUnmarked(value) { return unmarkedIdentity(value); }
+    for (const fn of [callNoop, callIdentity, callUnmarked]) {
+      %PrepareFunctionForOptimization(fn);
+      fn(31); fn(31);
+      %OptimizeMaglevOnNextCall(fn);
+      fn(31);
+    }
+  )JS");
+  CheckBoundedMaglev("callNoop");
+  CheckBoundedMaglev("callIdentity");
+  CheckBoundedMaglev("callUnmarked");
+  bounded_noop_fast = bounded_noop_slow = 0;
+  bounded_i32_fast = bounded_i32_slow = 0;
+  CHECK(CompileRun("callNoop()")->IsUndefined());
+  CHECK_EQ(1, bounded_noop_fast.load());
+  CHECK_EQ(0, bounded_noop_slow);
+  CHECK_EQ(v8::Utils::OpenDirectHandle(*env->Global())->ptr(),
+           bounded_receiver);
+  ExpectInt32("callIdentity(-2147483648)", std::numeric_limits<int32_t>::min());
+  ExpectInt32("callIdentity(2147483647)", std::numeric_limits<int32_t>::max());
+  CHECK_EQ(2, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  i::heap::InvokeMajorGC(CcTest::heap());
+  CHECK(CompileRun("callNoop()")->IsUndefined());
+  ExpectInt32("callIdentity(31)", 31);
+  CHECK_EQ(2, bounded_noop_fast.load());
+  CHECK_EQ(0, bounded_noop_slow);
+  CHECK_EQ(3, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  CHECK_EQ(v8::Utils::OpenDirectHandle(*env->Global())->ptr(),
+           bounded_receiver);
+  unmarked_gc = true;
+  ExpectInt32("callUnmarked(31)", 31);
+  CHECK_GT(unmarked_i32_slow, 0);
+  CHECK_EQ(0, unmarked_i32_fast);
+  // Each invalid value reaches a fresh, actually optimized typed guard. Reusing
+  // one caller would test only the ordinary callback after its first deopt.
+  const char* invalid_values[] = {"1.5",        "NaN",         "Infinity",
+                                  "2147483648", "-2147483649", "-0",
+                                  "'31'",       "{}",          "undefined"};
+  for (size_t index = 0; index < arraysize(invalid_values); ++index) {
+    const std::string name = "invalidGuard" + std::to_string(index);
+    const std::string setup =
+        "function " + name + "(value) { return boundedIdentity(value); }\n" +
+        "%PrepareFunctionForOptimization(" + name + ");" + name + "(31);" +
+        name + "(31); %OptimizeMaglevOnNextCall(" + name + ");" + name +
+        "(31);";
+    CompileRun(setup.c_str());
+    CheckBoundedMaglev(name.c_str());
+    bounded_i32_fast = bounded_i32_slow = 0;
+    const std::string rejected =
+        "(() => { try { " + name + "(" + invalid_values[index] +
+        "); } catch (e) { return e instanceof TypeError; } return false; })()";
+    ExpectTrue(rejected.c_str());
+    CHECK_EQ(0, bounded_i32_fast);
+    CHECK_EQ(1, bounded_i32_slow);
+  }
+  bounded_i32_fast = bounded_noop_fast = 0;
+  ExpectTrue(R"JS(
+    function missingArg() {
+      try { boundedIdentity(); } catch (e) { return e instanceof TypeError; }
+      return false;
+    }
+    function extraArg() {
+      try { boundedIdentity(1, 2); } catch (e) { return e instanceof TypeError; }
+      return false;
+    }
+    function extraNoopArg() {
+      try { boundedNoop(1); } catch (e) { return e instanceof TypeError; }
+      return false;
+    }
+    [missingArg, extraArg, extraNoopArg].every(fn => {
+      %PrepareFunctionForOptimization(fn);
+      if (!fn() || !fn()) return false;
+      %OptimizeMaglevOnNextCall(fn);
+      return fn() && %ActiveTierIsMaglev(fn);
+    });
+  )JS");
+  CHECK_EQ(0, bounded_i32_fast);
+  CHECK_EQ(0, bounded_noop_fast.load());
+  ExpectTrue(R"JS(
+    [() => boundedIdentity(), () => boundedIdentity(1, 2),
+     () => boundedNoop(1), () => strictIdentity(), () => strictIdentity(-0)]
+      .every(call => { try { call(); } catch (e) {
+        return e instanceof TypeError;
+      } return false; })
+  )JS");
+  ExpectTrue(R"JS(
+    (() => { try { strictIdentity(-0); } catch (e) {
+      return e.stack.includes('lo-bun:binding/bounded.identity');
+    } return false; })()
+  )JS");
+  ExpectTrue(R"JS(
+    strictIdentity.name === 'identity' && strictIdentity.length === 0 &&
+    !Object.hasOwn(strictIdentity, 'prototype') &&
+    (() => { try { new strictIdentity(1); } catch (e) {
+      return e instanceof TypeError;
+    } return false; })()
+  )JS");
+#endif
+}
