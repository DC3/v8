+    CHECK(terminator.Start());
+    CHECK(CompileRun("boundedLoop(2147483647)").IsEmpty());
+    terminator.Join();
+    CHECK(try_catch.HasTerminated());
+    CHECK_GT(bounded_noop_fast.load(), 0);
+    isolate->CancelTerminateExecution();
+  }
+  ExpectFalse("boundedCaught || boundedAfter");
+  CHECK(CompileRun("boundedNoop()")->IsUndefined());
+  ExpectInt32("strictIdentity(31)", 31);
+#endif
+}
