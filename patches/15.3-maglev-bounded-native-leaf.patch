+// -----------------------------------------------------------------------------
+// C-call target selection.
+
+namespace {
+void TestFastApiCallTargetOperand(TurboshaftInstructionSelectorTest* test,
+                                  Zone* zone, bool use_register_target) {
+  TurboshaftInstructionSelectorTest::StreamBuilder m(
+      test, MachineType::Int32(), MachineType::Pointer(), MachineType::Int32());
+  MachineSignature::Builder signature(zone, 1, 2);
+  signature.AddReturn(MachineType::Int32());
+  signature.AddParam(MachineType::Pointer());
+  signature.AddParam(MachineType::Int32());
+  CallDescriptor::Flags flags = CallDescriptor::kCanUseRoots;
+  if (use_register_target) flags |= CallDescriptor::kUseRegisterTarget;
+  const TSCallDescriptor* descriptor = TSCallDescriptor::Create(
+      Linkage::GetSimplifiedCDescriptor(zone, signature.Get(), flags),
+      CanThrow{false}, LazyDeoptOnThrow{false}, zone);
+  OpIndex callee = m.ExternalConstant(
+      ExternalReference::Create(0x12345678, ExternalReference::FAST_C_CALL));
+  OpIndex arguments[] = {m.Parameter(0), m.Parameter(1)};
+  m.Return(m.Call(callee, OpIndex::Invalid(), base::VectorOf(arguments),
+                  descriptor));
+  auto s =
+      m.Build(TurboshaftInstructionSelectorTest::kAllExceptNopInstructions);
+  Instruction* call = nullptr;
+  size_t call_count = 0;
+  for (size_t i = 0; i < s.size(); ++i) {
+    if (s[i]->arch_opcode() == kArchCallCFunction) {
+      call = s[i];
+      ++call_count;
+    }
+  }
+  ASSERT_EQ(1u, call_count);
+  ASSERT_NE(nullptr, call);
+  // The selection-only bit must not leak into the backend's nine-bit flags.
+  EXPECT_EQ(CallDescriptor::kCanUseRoots, call->misc());
+  const InstructionOperand* target = call->InputAt(0);
+  if (use_register_target) {
+    ASSERT_TRUE(target->IsUnallocated());
+    const auto* operand = UnallocatedOperand::cast(target);
+    EXPECT_TRUE(operand->HasRegisterPolicy());
+    EXPECT_FALSE(operand->HasFixedRegisterPolicy());
+    EXPECT_EQ(s.ToVreg(callee), s.ToVreg(target));
+  } else {
+    EXPECT_TRUE(target->IsImmediate());
+  }
+}
+}  // namespace
+
+TEST_F(TurboshaftInstructionSelectorTest, FastApiCallRegisterTarget) {
+  TestFastApiCallTargetOperand(this, zone(), true);
+}
+
+TEST_F(TurboshaftInstructionSelectorTest, FastApiCallDefaultImmediateTarget) {
+  TestFastApiCallTargetOperand(this, zone(), false);
+}
