+
+// The same scalar signature with the default contract may publish an exception
+// from the fast callback. Its exception propagation must not be elided.
+int32_t DefaultThrowingIdentity(v8::Local<v8::Value> receiver, int32_t value) {
+  ++default_throwing_i32_fast;
+  if (default_i32_throw) {
+    v8::Isolate* isolate = CcTest::isolate();
+    v8::HandleScope scope(isolate);
+    isolate->ThrowException(v8_str("default fast exception"));
+  }
+  return value;
+}
+
+class BoundedNativeMaglevTest {
+ public:
+  explicit BoundedNativeMaglevTest(bool use_turbofan = false)
+      : natives_(&i::v8_flags.allow_natives_syntax, true),
+        maglev_(&i::v8_flags.maglev, !use_turbofan),
+        turbofan_(&i::v8_flags.turbofan, use_turbofan),
+        turbolev_(&i::v8_flags.turbolev, false),
+        concurrent_(&i::v8_flags.concurrent_recompilation, false),
+        fast_api_(&i::v8_flags.turbo_fast_api_calls, true),
+        inlining_(&i::v8_flags.maglev_inlining, true) {
+    CHECK(i::SmiValuesAre32Bits());
+    CcTest::InitializeVM();
+    bounded_noop_fast = bounded_noop_slow = 0;
+    bounded_i32_fast = bounded_i32_slow = 0;
+    unmarked_i32_fast = unmarked_i32_slow = 0;
+    unmarked_gc = unmarked_deopt = false;
+    default_throwing_i32_fast = 0;
+    default_i32_throw = false;
+  }
+
+  void Install(v8::Local<v8::Context> context, bool for_turbofan = false) {
+    v8::Isolate* isolate = CcTest::isolate();
+    v8::HandleScope scope(isolate);
+    static const v8::CTypeInfo arguments[] = {
+        v8::CTypeInfo(v8::CTypeInfo::Type::kV8Value),
+        v8::CTypeInfo(v8::CTypeInfo::Type::kInt32)};
+    static const v8::CFunctionInfo noop_info(
+        v8::CTypeInfo(v8::CTypeInfo::Type::kVoid), 1, arguments,
+        v8::CFunctionInfo::Int64Representation::kNumber,
+        v8::CFunctionInfo::HasReceiver::kYes,
+        v8::CFunctionInfo::NativeCallContract::kBoundedNoVM);
+    static const v8::CFunctionInfo identity_info(
+        v8::CTypeInfo(v8::CTypeInfo::Type::kInt32), 2, arguments,
+        v8::CFunctionInfo::Int64Representation::kNumber,
+        v8::CFunctionInfo::HasReceiver::kYes,
+        v8::CFunctionInfo::NativeCallContract::kBoundedNoVM);
+    static const v8::CFunction noop(reinterpret_cast<const void*>(BoundedNoop),
+                                    &noop_info);
+    static const v8::CFunction identity(
+        reinterpret_cast<const void*>(BoundedIdentity), &identity_info);
+    static const v8::CFunction unmarked = v8::CFunction::Make(UnmarkedIdentity);
+    CHECK_EQ(v8::CFunctionInfo::NativeCallContract::kDefault,
+             unmarked.GetTypeInfo()->GetNativeCallContract());
+    auto install = [&](const char* name, v8::FunctionCallback callback,
+                       const v8::CFunction* fast) {
+      v8::Local<v8::Object> data = v8::Object::New(isolate);
+      CHECK(data->Set(context, v8_str("token"), v8_int(42)).FromJust());
+      auto function = v8::FunctionTemplate::New(
+                          isolate, callback, data, Local<v8::Signature>(), 0,
+                          v8::ConstructorBehavior::kThrow,
+                          v8::SideEffectType::kHasSideEffect, fast)
+                          ->GetFunction(context)
+                          .ToLocalChecked();
+      CHECK(context->Global()->Set(context, v8_str(name), function).FromJust());
+    };
+    install("boundedNoop", BoundedNoopSlow, &noop);
+    install("boundedIdentity", BoundedIdentitySlow, &identity);
+    install("unmarkedIdentity", UnmarkedIdentitySlow, &unmarked);
+    install("checkedIdentity", BoundedIdentitySlow, nullptr);
+    if (for_turbofan) {
+      static const v8::CFunction throwing =
+          v8::CFunction::Make(DefaultThrowingIdentity);
+      CHECK_EQ(v8::CFunctionInfo::NativeCallContract::kDefault,
+               throwing.GetTypeInfo()->GetNativeCallContract());
+      install("defaultIdentity", BoundedIdentitySlow, &throwing);
+      // This ordinary callback executes after the bounded leaf has returned,
+      // so it may GC and lazily deoptimize the caller without violating the
+      // bounded contract or asking a non-void fast call to lazily deoptimize.
+      install("unmarkedSlowIdentity", UnmarkedIdentitySlow, nullptr);
+    }
+
+    // Match the real getter's CompileFunction closure and free raw(value) call.
+    v8::ScriptOrigin origin(v8_str("lo-bun:binding/bounded.identity"));
+    v8::ScriptCompiler::Source source(v8_str(R"JS(
+      'use strict';
+      return ({ identity() {
+        if (arguments.length !== 1) { throw slow(); }
+        const value = arguments[0];
+        if (typeof value !== 'number' || value !== (value | 0) || same(value, -0)) {
+          throw slow(undefined);
+        }
+        return raw(value);
+      } }).identity;
+    )JS"),
+                                      origin);
+    v8::Local<v8::String> names[] = {v8_str("raw"), v8_str("slow"),
+                                     v8_str("same")};
+    auto factory =
+        v8::ScriptCompiler::CompileFunction(context, &source, 3, names)
+            .ToLocalChecked();
+    v8::Local<v8::Value> values[] = {CompileRun("boundedIdentity"),
+                                     CompileRun("checkedIdentity"),
+                                     CompileRun("Object.is")};
+    auto wrapper = factory->Call(context, v8::Undefined(isolate), 3, values)
+                       .ToLocalChecked();
+    CHECK(context->Global()
+              ->Set(context, v8_str("strictIdentity"), wrapper)
+              .FromJust());
+  }
+
+ private:
+  i::FlagScope<bool> natives_, maglev_, turbofan_, turbolev_, concurrent_,
+      fast_api_, inlining_;
+};
+
+i::DirectHandle<i::JSFunction> BoundedTestFunction(const char* name) {
+  return i::Cast<i::JSFunction>(v8::Utils::OpenDirectHandle(*CompileRun(name)));
+}
+
+void CheckBoundedMaglev(const char* name) {
+  CHECK(BoundedTestFunction(name)->ActiveTierIsMaglev(CcTest::i_isolate()));
+}
