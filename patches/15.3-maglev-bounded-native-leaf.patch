+      return e instanceof TypeError;
+    } return false; })()
+  )JS");
+  CHECK_EQ(0, bounded_i32_fast);
+  CHECK_EQ(1, bounded_i32_slow);
+  ExpectTrue("%ActiveTierIsTurbofan(tfStrict)");
+  bounded_i32_fast = bounded_i32_slow = 0;
+  ExpectTrue(R"JS(
+    (() => { try { tfStrict(-0); } catch (e) {
+      return e instanceof TypeError &&
+        e.stack.includes('lo-bun:binding/bounded.identity');
+    } return false; })()
