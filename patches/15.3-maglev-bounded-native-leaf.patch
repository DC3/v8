+TEST(FastApiBoundedNativeEarlyOsrPeelingTermination) {
+#if defined(V8_ENABLE_MAGLEV) && defined(V8_ENABLE_TURBOFAN) &&             \
+    !defined(V8_LITE_MODE) && defined(V8_TARGET_ARCH_X64) && V8_OS_LINUX && \
+    !defined(USE_SIMULATOR)
+  if (i::v8_flags.jitless || i::v8_flags.disable_optimizing_compilers) return;
+  BoundedNativeMaglevTest flags(true);
+  i::FlagScope<bool> peeling(&i::v8_flags.turbo_loop_peeling, true);
+  i::FlagScope<bool> inlining(&i::v8_flags.turbo_inlining, true);
+  i::FlagScope<bool> osr(&i::v8_flags.use_osr, true);
+  i::FlagScope<bool> concurrent_osr(&i::v8_flags.concurrent_osr, false);
+  v8::Isolate* isolate = CcTest::isolate();
+  v8::HandleScope scope(isolate);
+  LocalContext env;
+  flags.Install(env.local(), true);
+  CompileRun(R"JS(
+    var boundedCaught = false, boundedAfter = false, osrTerminationTier = [false];
+    function osrTerminatingLoop(count) {
+      try {
+        for (let i = 0; i < count; ++i) {
+          if (i === 0) %OptimizeOsr();
+          osrTerminationTier[0] = %CurrentFrameIsTurbofan();
+          boundedNoop();
+        }
+      } catch (e) { boundedCaught = true; }
+      boundedAfter = true;
+    }
+    %PrepareFunctionForOptimization(osrTerminatingLoop);
+    osrTerminatingLoop(32);
+  )JS");
+  ExpectTrue("osrTerminationTier[0]");
+  CHECK_GT(bounded_noop_fast.load(), 0);
+  CompileRun("boundedCaught = boundedAfter = osrTerminationTier[0] = false;");
+  bounded_noop_fast = bounded_noop_slow = 0;
+  TerminateExecutionThread terminator(isolate);
+  {
+    v8::TryCatch try_catch(isolate);
+    CHECK(terminator.Start());
+    CHECK(CompileRun("osrTerminatingLoop(2147483647)").IsEmpty());
+    terminator.Join();
+    CHECK(try_catch.HasTerminated());
+    CHECK_GT(bounded_noop_fast.load(), 0);
+    isolate->CancelTerminateExecution();
+  }
+  ExpectTrue("osrTerminationTier[0]");
+  ExpectFalse("boundedCaught || boundedAfter");
+  CHECK(CompileRun("boundedNoop()")->IsUndefined());
+  ExpectInt32("strictIdentity(31)", 31);
+#endif
+}
