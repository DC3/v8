+TEST(FastApiBoundedNativeMaglevDeopt) {
+#if defined(V8_ENABLE_MAGLEV) && defined(V8_TARGET_ARCH_X64) && V8_OS_LINUX && \
+    !defined(USE_SIMULATOR)
+  if (i::v8_flags.jitless || i::v8_flags.disable_optimizing_compilers) return;
+  BoundedNativeMaglevTest flags;
+  i::FlagScope<int> inline_size(&i::v8_flags.max_maglev_inlined_bytecode_size,
+                                300);
+  v8::HandleScope scope(CcTest::isolate());
+  LocalContext env;
+  flags.Install(env.local());
+  CompileRun(R"JS(
+    %PrepareFunctionForOptimization(strictIdentity);
+    strictIdentity(1); strictIdentity(2);
+    function overflow(value) { return boundedIdentity(value) + 1; }
+    function overflowStrict(value) { return strictIdentity(value) + 1; }
+    function afterLeaf(value) {
+      const retained = { value: 11 };
+      const result = strictIdentity(value);
+      unmarkedIdentity(value);
+      return result + retained.value;
+    }
+    for (const fn of [overflow, overflowStrict, afterLeaf]) {
+      %PrepareFunctionForOptimization(fn);
+      fn(1); fn(2);
+      %OptimizeMaglevOnNextCall(fn);
+      fn(3);
+    }
+  )JS");
+  CheckBoundedMaglev("overflow");
+  CheckBoundedMaglev("overflowStrict");
+  CheckBoundedMaglev("afterLeaf");
+  auto wrapper = BoundedTestFunction("strictIdentity");
+  auto data = BoundedTestFunction("overflowStrict")
+                  ->code(CcTest::i_isolate())
+                  ->deoptimization_data();
+  bool found_wrapper = false;
+  for (int i = 0; i < data->InlinedFunctionCount().value(); ++i) {
+    found_wrapper |= data->GetInlinedFunction(i) == wrapper->shared();
+  }
+  CHECK(found_wrapper);
+  bounded_i32_fast = bounded_i32_slow = 0;
+  CHECK_EQ(
+      2147483648.0,
+      CompileRun("overflow(2147483647)")->NumberValue(env.local()).FromJust());
+  CHECK_EQ(1, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  CHECK(!BoundedTestFunction("overflow")
+             ->ActiveTierIsMaglev(CcTest::i_isolate()));
+  bounded_i32_fast = bounded_i32_slow = 0;
+  CHECK_EQ(2147483648.0, CompileRun("overflowStrict(2147483647)")
+                             ->NumberValue(env.local())
+                             .FromJust());
+  CHECK_EQ(1, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  CHECK(!BoundedTestFunction("overflowStrict")
+             ->ActiveTierIsMaglev(CcTest::i_isolate()));
+  bounded_i32_fast = bounded_i32_slow = 0;
+  unmarked_gc = unmarked_deopt = true;
+  ExpectInt32("afterLeaf(31)", 42);
+  CHECK_EQ(1, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  CHECK_EQ(0, unmarked_i32_fast);
+  CHECK(!BoundedTestFunction("afterLeaf")
+             ->ActiveTierIsMaglev(CcTest::i_isolate()));
+#endif
+}
