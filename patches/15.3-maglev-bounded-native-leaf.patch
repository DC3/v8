+    function tfIdentity(value) { return boundedIdentity(value); }
+    function tfStrict(value) { return strictIdentity(value); }
+    function tfDefaultIdentity(value) { return defaultIdentity(value); }
+    function afterLeaf(value) {
+      const retained = { value: 11 };
+      const result = strictIdentity(value);
+      unmarkedSlowIdentity(value);
+      return result + retained.value;
+    }
+    for (const fn of [tfNoop, tfIdentity, tfStrict, tfDefaultIdentity, afterLeaf]) {
+      %PrepareFunctionForOptimization(fn);
+      fn(1); fn(2);
+      %OptimizeFunctionOnNextCall(fn);
+      fn(3);
+    }
+  )JS");
