+TEST(FastApiBoundedNativeMaglevTermination) {
+#if defined(V8_ENABLE_MAGLEV) && defined(V8_TARGET_ARCH_X64) && V8_OS_LINUX && \
+    !defined(USE_SIMULATOR)
