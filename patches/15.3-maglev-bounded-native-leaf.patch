+    function osrOverflow(count, requestOsr) {
+      let total = 2147483646;
+      for (let i = 0; i < count; ++i) {
+        if (requestOsr && i === 0) %OptimizeOsr();
+        osrOverflowTier[0] = osrOverflowTier[0] || %CurrentFrameIsTurbofan();
+        total += strictIdentity(1);
+      }
+      return total;
+    }
+    function afterLeaf(count, requestOsr) {
+      let total = 0;
+      for (let i = 0; i < count; ++i) {
+        if (requestOsr && i === 0) %OptimizeOsr();
+        const retained = { value: i };
+        const result = strictIdentity(31);
+        if (i === 1) {
+          osrDeoptTier[0] = %CurrentFrameIsTurbofan();
+          unmarkedSlowIdentity(result);
+          osrDeoptTier[1] = %CurrentFrameIsTurbofan();
+        }
+        total += result + retained.value;
+      }
+      return total;
+    }
+    function osrNested(count, requestOsr) {
+      let total = 0;
+      for (let i = 0; i < count; ++i) {
+        for (let j = 0; j < 2; ++j) {
+          if (requestOsr && i === 0 && j === 0) %OptimizeOsr();
+          total += strictIdentity(31);
+        }
+      }
+      return [total, %CurrentFrameIsTurbofan()];
+    }
+    for (const fn of [osrStrict, osrOverflow, afterLeaf, osrNested]) {
+      %PrepareFunctionForOptimization(fn);
+    }
+    // Prime the return literal and ordinary callback without installing a
+    // normal-entry optimized caller. Subsequent tier checks inspect OSR frames.
+    osrStrict(0, -1);
+    osrOverflow(1, false);
+    afterLeaf(4, false);
+    osrNested(0, false);
+    // Prime both increments before requesting OSR in the nested fallback.
+    osrNested(1, false);
+  )JS");
+  bounded_i32_fast = bounded_i32_slow = 0;
+  ExpectTrue("osrStrict(0, -1)[0] === 0");
+  CHECK_EQ(0, bounded_i32_fast + bounded_i32_slow);
+  // One call before the OSR backedge leaves zero remaining iterations;
+  // two calls leave one remaining OSR iteration; ten also exercise the
+  // residual loop.
+  for (int count : {1, 2, 10}) {
+    bounded_i32_fast = bounded_i32_slow = 0;
+    std::string source =
+        "var osrResult = osrStrict(" + std::to_string(count) + ", -1);";
+    CompileRun(source.c_str());
+    ExpectTrue("osrResult[1]");
+    CHECK_EQ(31 * count,
+             CompileRun("osrResult[0]")->Int32Value(env.local()).FromJust());
+    CHECK_EQ(count, bounded_i32_fast + bounded_i32_slow);
+    if (count > 1) CHECK_GT(bounded_i32_fast, 0);
+  }
+
+  // Rejection before OSR, on its first iteration, and later must not enter
+  // the leaf with an invalid input, change its virtual origin, or replay a
+  // call.
+  for (int throw_at : {0, 1, 3}) {
+    bounded_i32_fast = bounded_i32_slow = 0;
+    CompileRun("osrThrowTier[0] = false;");
+    std::string source =
+        "(() => { try { osrStrict(8, " + std::to_string(throw_at) +
+        "); } catch (e) { return e instanceof TypeError && e.message === 'i32'"
+        " && e.stack.includes('lo-bun:binding/bounded.identity'); }"
+        " return false; })()";
+    CHECK(CompileRun(source.c_str())->IsTrue());
+    CHECK_EQ(throw_at + 1, bounded_i32_fast + bounded_i32_slow);
+    if (throw_at == 0) {
+      ExpectFalse("osrThrowTier[0]");
+      CHECK_EQ(0, bounded_i32_fast);
+    } else {
+      ExpectTrue("osrThrowTier[0]");
+    }
+  }
+
+  bounded_i32_fast = bounded_i32_slow = 0;
+  ExpectTrue("osrOverflow(3, true) === 2147483649 && osrOverflowTier[0]");
+  CHECK_EQ(3, bounded_i32_fast + bounded_i32_slow);
+  CHECK_GT(bounded_i32_fast, 0);
+
+  // This callback may GC and lazily deoptimize after the marked call returned.
+  // Its primed call site must preserve the returned value and retained object,
+  // resume after the callback, and execute every marked invocation exactly
+  // once.
+  bounded_i32_fast = bounded_i32_slow = 0;
+  unmarked_i32_fast = unmarked_i32_slow = 0;
+  unmarked_gc = unmarked_deopt = true;
+  i::heap::InvokeMajorGC(CcTest::heap());
+  ExpectInt32("afterLeaf(10, true)", 355);
+  CHECK_EQ(10, bounded_i32_fast + bounded_i32_slow);
+  CHECK_GT(bounded_i32_fast, 0);
+  CHECK_EQ(1, unmarked_i32_slow);
+  CHECK_EQ(0, unmarked_i32_fast);
+  ExpectTrue("osrDeoptTier[0] && !osrDeoptTier[1]");
+  unmarked_gc = unmarked_deopt = false;
+
+  // Nested loops remain eligible only for the existing late pipeline.
+  bounded_i32_fast = bounded_i32_slow = 0;
+  CompileRun("var nestedResult = osrNested(4, true);");
+  ExpectTrue("nestedResult[0] === 248 && nestedResult[1]");
+  CHECK_EQ(8, bounded_i32_fast + bounded_i32_slow);
+  CHECK_GT(bounded_i32_fast, 0);
+#endif
+}
