+  // GC and caller lazy deoptimization occur in a later ordinary API callback,
+  // after the marked leaf has returned. Restoring the caller must not replay
+  // the marked call or lose its returned value.
+  ExpectTrue("%ActiveTierIsTurbofan(afterLeaf)");
+  bounded_i32_fast = bounded_i32_slow = 0;
+  unmarked_i32_slow = 0;
+  unmarked_gc = unmarked_deopt = true;
+  ExpectInt32("afterLeaf(31)", 42);
+  CHECK_EQ(1, bounded_i32_fast);
+  CHECK_EQ(0, bounded_i32_slow);
+  CHECK_EQ(1, unmarked_i32_slow);
+  CHECK_EQ(0, unmarked_i32_fast);
+  ExpectFalse("%ActiveTierIsTurbofan(afterLeaf)");
+#endif
