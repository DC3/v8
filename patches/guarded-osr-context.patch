+  v8::Local<v8::Value> result = CompileRun(R"JS(
+    (() => {
+      function check(ok) { if (!ok) throw new Error('OSR context'); }
+      function make(value) {
+        let cell = value;
+        function run(deopt, requireOsr) {
+          check(!%CurrentFrameIsTurbofan());
+          let entered = false;
+          let escaped;
+          for (let i = 0; i < 40; ++i) {
+            if (i === 8) %OptimizeOsr();
+            if (i === 16) {
+              entered = %CurrentFrameIsTurbofan();
+              escaped = () => cell;
+              if (deopt) %DeoptimizeNow();
+            }
+          }
+          if (requireOsr) check(entered);
+          return [cell, escaped(), entered];
+        }
+        %PrepareFunctionForOptimization(run);
+        return {run, set(value) { cell = value; }};
+      }
+      const a = make(23);
+      let result = a.run(false, true);
+      check(result[0] === 23 && result[1] === 23);
+      const object = {};
+      for (const value of [4, 4.2, null, object]) {
+        a.set(value);
+        result = a.run(false, true);
+        check(result[0] === value && result[1] === value);
+      }
+      // Keep a's OSR code alive before creating a second closure of the SFI.
+      const b = make(91);
+      result = b.run(false, false);
+      check(result[0] === 91 && result[1] === 91);
+      // A guard miss may resume unoptimized; the next explicit OSR is generic.
+      for (const current of [b, a, b]) {
+        result = current.run(true, true);
